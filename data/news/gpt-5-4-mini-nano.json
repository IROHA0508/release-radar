  "prompts": [
    {
      "title": "서브에이전트에게 주는 좁은 작업",
      "when": "mini에게 검색이나 확인 같은 보조 작업을 맡길 때",
      "type": "prompt",
      "text": "너는 코드 검색 담당 서브에이전트야.\n\n작업: 저장소에서 [함수명]을 호출하는 모든 위치를 찾아.\n출력 형식: 파일 경로:줄 번호 - 호출 맥락 한 줄\n\n- 코드를 수정하지 마\n- 찾은 결과만 보고하고 해석은 덧붙이지 마"
    },
    {
      "title": "nano로 고객 문의 대량 분류 (Python)",
      "when": "정해진 라벨로 많은 텍스트를 분류할 때",
      "type": "code",
      "text": "from openai import OpenAI\n\nclient = OpenAI()\nLABELS = [\"버그\", \"기능 요청\", \"질문\", \"기타\"]\n\ndef classify(text: str) -> str:\n    resp = client.responses.create(\n        model=\"gpt-5.4-nano\",\n        input=f\"다음 고객 문의를 {LABELS} 중 하나로만 분류해. 라벨만 출력해.\\n\\n{text}\",\n    )\n    return resp.output_text.strip()"
    }
  ],
  "cautions": [
